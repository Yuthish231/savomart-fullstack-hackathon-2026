# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose exposes PostGIS on 5433 to avoid clashing with a local Postgres) ---
DATABASE_URL=postgresql+psycopg://sitescout:sitescout@localhost:5433/sitescout

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# One-click persona login for the demo. Set false in any real deployment.
DEMO_MODE=true

# --- LLM (any OpenAI-compatible endpoint: Groq, OpenAI, Ollama...) ---
# Leave LLM_API_KEY empty to run with template-only narratives.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=1500
# gpt-oss models: low|medium|high. "low" keeps hidden reasoning tokens down (free tiers cap tokens/minute).
LLM_REASONING_EFFORT=low
# On HTTP 429, wait as long as the provider asks, up to this many seconds per call.
LLM_RATE_LIMIT_WAIT_S=90

# --- Savomart Stores API ---
STORES_API_URL=https://internal-service.savomart.in/bridge/api/store/list?is_operational=True
STORES_API_TOKEN=

# --- Nominatim (usage policy requires an identifying User-Agent; placeholder e-mails are rejected) ---
NOMINATIM_USER_AGENT=SavoSiteScout/0.1 (Savomart hackathon prototype; low-volume, cached)

# --- Web ---
CORS_ORIGINS=http://localhost:5173
MEDIA_DIR=./media
